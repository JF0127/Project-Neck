# ================= Project-Neck 根 .gitignore =================
# Git 提交源码、配置、文档和测试；本地数据与可再生成产物只保留在工作区。

# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

.venv/
venv/
env/

.coverage
htmlcov/

# ============================================================
# OS / IDE
# ============================================================

.DS_Store
Thumbs.db

.vscode/
.idea/

*.swp
*.swo
*~
.ipynb_checkpoints/

# ============================================================
# Dataset artifacts
# ============================================================

# Generated videos, metadata, features, fragments, splits and analysis.
/dataset/datasets/*
!/dataset/datasets/.gitkeep

# ============================================================
# Downloaded dataset models
# ============================================================

/dataset/models/*
!/dataset/models/.gitkeep

# Runtime Whisper models are also downloaded locally.
/models/

# ============================================================
# Algorithm data and training outputs
# ============================================================

/modules/algorithm/data/
/modules/algorithm/outputs/*
!/modules/algorithm/outputs/.gitkeep

# ============================================================
# Build artifacts
# ============================================================

/board/xiaozhi-esp32/build/
/modules/motor/build/

CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.o
*.a

# ============================================================
# Motor audit artifacts
# ============================================================

/modules/motor/logs/audit_*/

# ============================================================
# Experiment artifacts
# ============================================================

# Keep experiment scripts, README files and configs trackable.
/experiments/*/runs/*
/experiments/*/sessions/*

# ============================================================
# Runtime recordings
# ============================================================

/modules/audio/recordings/*
!/modules/audio/recordings/.gitkeep

# ============================================================
# Common media artifacts
# ============================================================

*.mp4
*.mov
*.mkv
*.avi

# ============================================================
# Other generated artifacts
# ============================================================

**/artifacts/
artifacts/
