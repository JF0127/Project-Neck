# ================= Project-Neck 根 .gitignore =================
# 覆盖两个子项目：modules/algorithm（模型端）与 modules/motor（实机端）。
# 原则：只入库源码/配置/文档/测试，不入库数据、虚拟环境与可再生成产物。

# ---------------- 通用 ----------------
.DS_Store
Thumbs.db
*.pyc
__pycache__/
*.egg-info/
.ipynb_checkpoints/
.idea/
.vscode/
*.swp
*~

# ---------------- modules/algorithm：虚拟环境与缓存 ----------------
modules/algorithm/.venv/
modules/algorithm/.pytest_cache/

# ---------------- modules/algorithm：数据集（6.3G，只读，严禁入库） ----------------
modules/algorithm/data/

# ---------------- modules/algorithm：训练/推理产物（1.4G，可重新生成） ----------------
# 包含各版本 checkpoint(约 65M/个)、mvp 轨迹 npy/json、审计 json 等。
# 如需把 v3 冻结模型入库，可强制添加：
#   git add -f modules/algorithm/outputs/neck_motion_v3/checkpoints/best.pt
modules/algorithm/outputs/

# ---------------- modules/motor：构建产物 ----------------
modules/motor/build/
*.o
*.a

# ---------------- modules/motor：审计落盘（保留日志文档 logs/*.md） ----------------
modules/motor/logs/audit_*/

# ---------------- whisper 模型(145MB, 可从 hf-mirror 重新下载) ----------------
model/

experiments/